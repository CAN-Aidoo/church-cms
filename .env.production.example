# Sonlife Church CMS - Production Environment Variables
# Copy these to Render's Environment settings

# ===========================================
# APPLICATION SETTINGS
# ===========================================
APP_NAME="Sonlife Church CMS"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                          # Generate with: php artisan key:generate --show
APP_URL=https://your-app.onrender.com

# ===========================================
# LOGGING
# ===========================================
LOG_CHANNEL=stderr
LOG_LEVEL=error

# ===========================================
# DATABASE (TiDB Cloud / MySQL)
# ===========================================
# Get credentials from TiDB Cloud Console > Your Cluster > Connect > General
DB_CONNECTION=mysql
DB_HOST=                          # Your TiDB Cloud host (e.g., gateway01.us-east-1.prod.aws.tidbcloud.com)
DB_PORT=4000                      # TiDB default port (use 3306 for standard MySQL)
DB_DATABASE=                      # Your database name
DB_USERNAME=                      # Your TiDB username (e.g., xxxxx.root)
DB_PASSWORD=                      # Your TiDB password

# SSL Configuration (required for TiDB Cloud)
# MYSQL_ATTR_SSL_CA path varies by OS:
#   - Linux (Render/Railway): /etc/ssl/certs/ca-certificates.crt
#   - macOS: /etc/ssl/cert.pem
#   - Windows: Leave blank or provide path to downloaded CA bundle
# Leave blank if your deployment platform handles SSL automatically
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt
DB_SSL_MODE=require               # Use 'require' for TiDB Cloud
DB_SSL_VERIFY=true

# ===========================================
# SESSION, CACHE & QUEUE
# ===========================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_DRIVER=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# ===========================================
# MAIL CONFIGURATION
# ===========================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourchurch.com
MAIL_FROM_NAME="Sonlife Church"

# ===========================================
# CHURCH CONFIGURATION
# ===========================================
CHURCH_NAME="Sonlife City Church"
CHURCH_ADDRESS="Opposite Residency Street, Sunyani, Ghana"
CHURCH_PHONE="+233240271064"
CHURCH_EMAIL="info@sonlifechurch.com"

# ===========================================
# SMS (TWILIO)
# ===========================================
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_PHONE=
TWILIO_ENABLED=true

# ===========================================
# FINANCIAL SETTINGS
# ===========================================
CURRENCY=GHS
DUAL_APPROVAL_THRESHOLD=5000
MAX_FLOCK_SIZE=15
ATTENDANCE_COMMITTED_THRESHOLD=0.80

# ===========================================
# FEATURE FLAGS
# ===========================================
ENABLE_SMS_BROADCASTS=true
ENABLE_ONLINE_GIVING=false
ENABLE_TWO_FACTOR_AUTH=false
