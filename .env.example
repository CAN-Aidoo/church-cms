APP_NAME="Church Management System"
APP_ENV=local  # Use 'production' for Railway deployment
# REQUIRED: Application key - MUST be generated before deployment
# Generate with: php artisan key:generate --show
# Without this key, the application will fail to start
APP_KEY=
APP_DEBUG=true  # Set to 'false' for production/Railway
APP_URL=http://localhost  # Use your Railway URL in production (e.g., https://your-app.up.railway.app)

# Asset URL - REQUIRED for Railway deployment (CSS/JS will not load without this)
# MUST be set to your Railway URL in production
# Example: ASSET_URL=https://your-app.up.railway.app
ASSET_URL=https://your-app.up.railway.app

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug  # Use 'error' for production

# Database Configuration (TiDB Cloud)
# Get credentials from TiDB Cloud Console > Connect > General
DB_CONNECTION=mysql
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_DATABASE=church_management
DB_USERNAME=your_tidb_username
DB_PASSWORD=your_tidb_password
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# Broadcasting, Cache, Queue, Session
# For Railway: Use 'database' driver (no Redis required for simplicity)
BROADCAST_DRIVER=log
CACHE_DRIVER=file  # Use 'file' for simple deployments (no Redis/database needed)
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync  # Use 'sync' for simple deployments (or 'database' if migrations ran)
SESSION_DRIVER=file  # Use 'file' for simple deployments (no Redis/database needed)
SESSION_LIFETIME=120

# Redis (Optional - uncomment and add Redis service if needed)
# REDIS_HOST=127.0.0.1  # Railway will set REDISHOST automatically
# REDIS_PASSWORD=null    # Railway will set REDISPASSWORD automatically
# REDIS_PORT=6379        # Railway will set REDISPORT automatically

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@churchcms.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Church-specific Configuration
CHURCH_NAME="My Church"
CHURCH_ADDRESS="123 Church Street, City, Country"
CHURCH_PHONE="+233XXXXXXXXX"
CHURCH_EMAIL="info@mychurch.com"

# Twilio SMS Configuration
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_ENABLED=false

# Payment Gateway Configuration - Paystack (Card Payments)
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxx

# Payment Gateway Configuration - Hubtel (Ghana Mobile Money: MTN, Vodafone, AirtelTigo)
HUBTEL_CLIENT_ID=xxxxxxxxxxxxx
HUBTEL_CLIENT_SECRET=xxxxxxxxxxxxx
HUBTEL_MERCHANT_ID=xxxxxxxxxxxxx

# Financial Configuration
CURRENCY=GHS
DUAL_APPROVAL_THRESHOLD=5000
MAX_FLOCK_SIZE=15
ATTENDANCE_COMMITTED_THRESHOLD=0.80

# Feature Flags
ENABLE_SMS_BROADCASTS=true
ENABLE_ONLINE_GIVING=true
ENABLE_TWO_FACTOR_AUTH=false
