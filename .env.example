APP_NAME="Church Management System"
APP_ENV=local  # Use 'production' for Koyeb deployment
# REQUIRED: Application key - MUST be generated before deployment
# Generate with: php artisan key:generate --show
# Without this key, the application will fail to start
APP_KEY=
APP_DEBUG=true  # Set to 'false' for production/Koyeb
APP_URL=http://localhost  # Use your Koyeb URL in production (e.g., https://your-app.koyeb.app)

# Asset URL - REQUIRED for Koyeb deployment (CSS/JS will not load without this)
# MUST be set to your Koyeb URL in production
# Example: ASSET_URL=https://your-app.koyeb.app
ASSET_URL=https://your-app.koyeb.app

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug  # Use 'error' for production

# Database Configuration
# For Koyeb: Use Koyeb managed database or external MySQL/PostgreSQL
DB_CONNECTION=mysql
DB_HOST=127.0.0.1  # Use your Koyeb database host
DB_PORT=3306
DB_DATABASE=church_management
DB_USERNAME=root
DB_PASSWORD=

# Broadcasting, Cache, Queue, Session
# For Koyeb: Use 'database' driver (no Redis required for free tier)
BROADCAST_DRIVER=log
CACHE_DRIVER=database  # Changed from redis to database for Koyeb compatibility
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database  # Changed from redis to database for Koyeb compatibility
SESSION_DRIVER=database  # Changed from redis to database for Koyeb compatibility
SESSION_LIFETIME=120

# Redis (Optional - comment out if using database drivers)
# MEMCACHED_HOST=127.0.0.1
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@churchcms.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Church-specific Configuration
CHURCH_NAME="My Church"
CHURCH_ADDRESS="123 Church Street, City, Country"
CHURCH_PHONE="+233XXXXXXXXX"
CHURCH_EMAIL="info@mychurch.com"

# Twilio SMS Configuration
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_ENABLED=false

# Payment Gateway Configuration - Paystack (Card Payments)
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxx

# Payment Gateway Configuration - Hubtel (Ghana Mobile Money: MTN, Vodafone, AirtelTigo)
HUBTEL_CLIENT_ID=xxxxxxxxxxxxx
HUBTEL_CLIENT_SECRET=xxxxxxxxxxxxx
HUBTEL_MERCHANT_ID=xxxxxxxxxxxxx

# Financial Configuration
CURRENCY=GHS
DUAL_APPROVAL_THRESHOLD=5000
MAX_FLOCK_SIZE=15
ATTENDANCE_COMMITTED_THRESHOLD=0.80

# Feature Flags
ENABLE_SMS_BROADCASTS=true
ENABLE_ONLINE_GIVING=true
ENABLE_TWO_FACTOR_AUTH=false
