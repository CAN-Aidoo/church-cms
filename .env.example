APP_NAME="Church Management System"
APP_ENV=local  # Use 'production' for cloud deployment
# REQUIRED: Application key - MUST be generated before deployment
# Generate with: php artisan key:generate --show
# Without this key, the application will fail to start
APP_KEY=
APP_DEBUG=true  # Set to 'false' for production
APP_URL=http://localhost  # Use your production URL (e.g., https://your-app.onrender.com)

# Asset URL - REQUIRED for production (CSS/JS will not load without this)
# MUST be set to your production URL
# Example: ASSET_URL=https://your-app.onrender.com
ASSET_URL=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug  # Use 'error' for production

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Supports MySQL, TiDB Cloud, Railway MySQL, or any MySQL-compatible database
#
# For TiDB Cloud:
#   1. Go to TiDB Cloud Console > Your Cluster > Connect > General
#   2. Copy the host, port (usually 4000), username, and generate a password
#   3. TiDB requires SSL - set MYSQL_ATTR_SSL_CA to your system's CA bundle
#
# For Railway:
#   Railway auto-injects MYSQLHOST, MYSQLPORT, MYSQLDATABASE, MYSQLUSER, MYSQLPASSWORD
#   You can leave DB_* blank and the app will use Railway's injected variables
#
# For local development:
#   Use your local MySQL/MariaDB credentials
# ===========================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306                      # Use 4000 for TiDB Cloud
DB_DATABASE=church_management
DB_USERNAME=root
DB_PASSWORD=

# SSL Configuration (required for TiDB Cloud and some cloud MySQL providers)
# MYSQL_ATTR_SSL_CA: Path to CA certificate bundle
#   - Linux: /etc/ssl/certs/ca-certificates.crt
#   - macOS: /etc/ssl/cert.pem
#   - Windows: Leave blank (uses system store) or download CA bundle
#   - Leave blank to use PDO/system defaults (works for most local setups)
# DB_SSL_MODE: Set to 'require' for TiDB Cloud, null for local
# DB_SSL_VERIFY: Set to true to verify server certificate
MYSQL_ATTR_SSL_CA=
DB_SSL_MODE=
DB_SSL_VERIFY=true

# Broadcasting, Cache, Queue, Session
BROADCAST_DRIVER=log
CACHE_DRIVER=file  # Use 'database' for production
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync  # Use 'database' for production
SESSION_DRIVER=file  # Use 'database' for production
SESSION_LIFETIME=120

# Redis (Optional)
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@churchcms.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Church-specific Configuration
CHURCH_NAME="My Church"
CHURCH_ADDRESS="123 Church Street, City, Country"
CHURCH_PHONE="+233XXXXXXXXX"
CHURCH_EMAIL="info@mychurch.com"

# Twilio SMS Configuration
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_ENABLED=false

# Payment Gateway Configuration - Paystack (Card Payments)
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxx

# Payment Gateway Configuration - Hubtel (Ghana Mobile Money: MTN, Vodafone, AirtelTigo)
HUBTEL_CLIENT_ID=xxxxxxxxxxxxx
HUBTEL_CLIENT_SECRET=xxxxxxxxxxxxx
HUBTEL_MERCHANT_ID=xxxxxxxxxxxxx

# Financial Configuration
CURRENCY=GHS
DUAL_APPROVAL_THRESHOLD=5000
MAX_FLOCK_SIZE=15
ATTENDANCE_COMMITTED_THRESHOLD=0.80

# Feature Flags
ENABLE_SMS_BROADCASTS=true
ENABLE_ONLINE_GIVING=true
ENABLE_TWO_FACTOR_AUTH=false
